{
  "name": "dsh-path-lockbox",
  "version": "0.1.3",
  "description": "DeepSeek Harness (dsh) 插件：按 文件/文件夹/硬盘 三类锁定路径，guard 单调拒绝 + pre-execute 拦截 + post-execute 结果过滤 + 变化监控。UI 参照 Windows 索引选项布局。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test tests/match.test.js tests/extract.test.js tests/host.test.js"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.2.0-rc.2"
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  },
  "license": "MIT",
  "author": "thson-xue",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thson-xue/dsh-path-lockbox.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "path-protection",
    "file-guard",
    "sandbox"
  ]
}
